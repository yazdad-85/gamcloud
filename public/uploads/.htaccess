# Deny script execution under uploaded media.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<FilesMatch "\.(?i:php|phtml|phar|php\d+)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
