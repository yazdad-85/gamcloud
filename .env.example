#--------------------------------------------------------------------
# Cuplikan .env produksi — salin ke `.env` di server lalu isi nilai nyata.
# JANGAN commit file `.env` (sudah di .gitignore).
# Generate encryption.key: php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)), PHP_EOL;"
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://DOMAIN-ANDA/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

# MySQL/MariaDB (disarankan produksi). Untuk SQLite ganti DBDriver + path di luar webroot.
database.default.hostname = localhost
database.default.database = ular_tangga
database.default.username = DB_USER
database.default.password = DB_PASSWORD_KUAT
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

encryption.key = hex2bin:GANTI_DENGAN_64_HEX_CHARS

# Hanya untuk `php spark db:seed AuthUserSeeder` (jangan pakai password lama dari git history)
SEED_SUPERADMIN_PASSWORD = 'GANTI_PASSWORD_SUPERADMIN_MIN_10'
SEED_TEACHER_PASSWORD = 'GANTI_PASSWORD_GURU_DEMO_MIN_10'

security.csrfProtection = session

# Cookie aman di HTTPS (set true di produksi)
# cookie.secure = true

#--------------------------------------------------------------------
# Email (verifikasi daftar guru)
#--------------------------------------------------------------------
email.fromEmail = 'noreply@DOMAIN-ANDA'
email.fromName = 'Ular Tangga Edukatif'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.DOMAIN-ANDA'
email.SMTPUser = 'SMTP_USER'
email.SMTPPass = 'SMTP_PASSWORD'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.SMTPTimeout = 10
email.mailType = 'html'
email.charset = 'UTF-8'

#--------------------------------------------------------------------
# Realtime (opsional — kosongkan jika tidak pakai Pusher)
#--------------------------------------------------------------------
PUSHER_APP_ID = ''
PUSHER_APP_KEY = ''
PUSHER_APP_SECRET = ''
PUSHER_APP_CLUSTER = 'ap1'

#--------------------------------------------------------------------
# Game (nilai default di Config\Game jika tidak di-override kode)
#--------------------------------------------------------------------
GAME_PIN_TTL_MINUTES = 180
TEAM_SESSION_TTL_MINUTES = 240
GAME_DEFAULT_QUESTION_TIME = 30
GAME_REDEMPTION_TIME = 10

logger.threshold = 4
